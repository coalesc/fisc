# Adapter to use: ifirm | taxprep
FISC_ADAPTER=ifirm

# Entitlements the operator asserts the firm holds, comma-separated.
# The adapter refuses to start until every id in its `requires` list is here.
# See docs/entitlements.md.
FISC_ENTITLEMENTS=ifirm.taxprep_module,ifirm.api_administration_role,ifirm.credentials_stay_in_firm_environment

# --- ifirm: CCH iFirm Taxprep, cloud ---
# The firm's own site. This process runs where the firm controls it; the key
# is read from that environment and is not transported anywhere else.
IFIRM_SITE_URL=https://your-firm.cchifirm.ca
IFIRM_API_KEY=minted-in-settings-taxprep-api-administration
# JSON: { "<tax_year>": { "<concept>": "<cellPath>" } }. Supplied by the
# operator, never committed here.
IFIRM_CELL_MAP_PATH=/path/to/cell-map.json
IFIRM_TIMEOUT_SECONDS=30

# --- taxprep: Taxprep desktop, COM ---
# No transport is implemented yet. Runs on the firm's Windows host only.
